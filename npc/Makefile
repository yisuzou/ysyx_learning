NPC_HOME ?= $(abspath .)
NEMU_HOME ?= $(abspath ../nemu)

# Sanity check
ifeq ($(wildcard $(NPC_HOME)/csrc/npc-main.cpp),)
  $(error NPC_HOME=$(NPC_HOME) is not an NPC repo)
endif
ifeq ($(wildcard $(NEMU_HOME)/tools/kconfig/Makefile),)
  $(error NEMU_HOME=$(NEMU_HOME) does not provide the Kconfig tools)
endif

.DEFAULT_GOAL := default

# Include variables generated by menuconfig
-include $(NPC_HOME)/include/config/auto.conf
-include $(NPC_HOME)/include/config/auto.conf.cmd

remove_quote = $(patsubst "%",%,$(1))

# Extract variables from menuconfig
GUEST_ISA ?= $(call remove_quote,$(CONFIG_ISA))
NAME = $(GUEST_ISA)-npc

# Include all filelist.mk files to merge source lists
FILELIST_MK = $(shell find -L csrc vsrc -name "filelist.mk")
include $(FILELIST_MK)

# Resolve directory lists and blacklists into the final source lists
DIRS-BLACKLIST-y += $(DIRS-BLACKLIST)
SRCS-BLACKLIST-y += $(if $(DIRS-BLACKLIST-y), \
	$(shell find -L $(DIRS-BLACKLIST-y) \
		\( -name "*.c" -o -name "*.cc" -o -name "*.cpp" \)),)
SRCS-BLACKLIST-y += $(SRCS-BLACKLIST)
SRCS-y += $(if $(DIRS-y),$(shell find -L $(DIRS-y) \
	\( -name "*.c" -o -name "*.cc" -o -name "*.cpp" \)),)
SRCS = $(filter-out $(SRCS-BLACKLIST-y),$(SRCS-y))

VDIRS-BLACKLIST-y += $(VDIRS-BLACKLIST)
VSRCS-BLACKLIST-y += $(if $(VDIRS-BLACKLIST-y), \
	$(shell find -L $(VDIRS-BLACKLIST-y) -name "*.v"),)
VSRCS-BLACKLIST-y += $(VSRCS-BLACKLIST)
VSRCS-y += $(if $(VDIRS-y),$(shell find -L $(VDIRS-y) -name "*.v"),)
VSRCS = $(filter-out $(VSRCS-BLACKLIST-y),$(VSRCS-y))

# Reject superseded command-line configuration
ifneq ($(origin ITRACE),undefined)
  $(error ITRACE= is no longer a build option; use 'make -C npc menuconfig')
endif
ifneq ($(origin MTRACE),undefined)
  $(error MTRACE= is no longer a build option; use 'make -C npc menuconfig')
endif
ifneq ($(origin FTRACE),undefined)
  $(error FTRACE= is no longer a build option; use 'make -C npc menuconfig')
endif
ifneq ($(origin TRACE_FLAGS),undefined)
  $(error TRACE_FLAGS= is no longer a build option; enable WAVE_TRACE in menuconfig)
endif

# Include configuration and native simulator build rules
include $(NPC_HOME)/scripts/config.mk
include $(NPC_HOME)/scripts/native.mk
